{
    "include": [
        "./index.js",
        "../../src-scripts/types/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "build",
        "docs",
        "src-scripts/src"
    ],
    "compilerOptions": {
        "rootDir": ".",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "strict": true,
        "sourceMap": true
    }
}