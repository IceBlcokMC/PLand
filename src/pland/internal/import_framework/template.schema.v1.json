{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "PLand DEL 数据导入清洗模板",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$version",
        "$source-loaders",
        "land"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "引用的 JSON Schema 定义"
        },
        "$version": {
            "type": "integer",
            "minimum": 1,
            "description": "模板版本号"
        },
        "$source-loaders": {
            "type": "object",
            "description": "配置 source 数据加载逻辑和挂载点，Key 为标准 JSON Pointer（以 '/' 开头）",
            "additionalProperties": false,
            "patternProperties": {
                "^/": {
                    "type": "object",
                    "properties": {
                        "adapter": {
                            "type": "string",
                            "enum": [
                                "json-file",
                                "level-db"
                            ],
                            "description": "配置数据的加载器"
                        },
                        "path": {
                            "type": "string",
                            "description": "配置数据的路径(基于用户指定的 dir + path 拼接合成完整路径)"
                        }
                    },
                    "required": [
                        "adapter",
                        "path"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "land": {
            "type": "object",
            "description": "配置领地数据转换模板",
            "additionalProperties": false,
            "properties": {
                "$records": {
                    "type": "string",
                    "$comment": "https://github.com/engsr6982/del#records"
                },
                "$source": {
                    "type": "string",
                    "$comment": "https://github.com/engsr6982/del#source"
                },
                "$where": {
                    "type": "string",
                    "$comment": "https://github.com/engsr6982/del#where"
                }
            },
            "patternProperties": {
                "^/": {
                    "type": "string",
                    "description": "挂载 JSON Pointer 映射到 DEL 表达式（例如：'/path/to/data'）"
                }
            }
        }
    }
}