#include "pland/_version.h"

#include <windows.h>
#include "winres.h"

#pragma code_page(65001)

VS_VERSION_INFO VERSIONINFO
FILEVERSION     PLAND_VERSION_MAJOR,PLAND_VERSION_MINOR,PLAND_VERSION_PATCH
PRODUCTVERSION  PLAND_VERSION_MAJOR,PLAND_VERSION_MINOR,PLAND_VERSION_PATCH
FILEFLAGSMASK   0x3fL
FILEFLAGS       PLAND_FILE_VERSION_FLAG
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "IceBlcokMC"
            VALUE "FileDescription",  "A land system based on LeviLamina"
            VALUE "FileVersion",      PLAND_FULL_VERSION_STRING
            VALUE "InternalName",     "PLand.dll"
            VALUE "LegalCopyright",   "Copyright (C) 2024-present IceBlcokMC Team and contributors"
            VALUE "OriginalFilename", "PLand.dll"
            VALUE "ProductName",      "PLand"
            VALUE "ProductVersion",   PLAND_FULL_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END